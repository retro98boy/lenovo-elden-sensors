diff --git a/tests/test_registry.c b/tests/test_registry.c
new file mode 100644
index 0000000..75a7684
--- /dev/null
+++ b/tests/test_registry.c
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include "../hexagonrpcd/hexagonfs.h"
+#include "../hexagonrpcd/rpcd_builder.h"
+
+int main(int argc, char **argv)
+{
+	struct hexagonfs_fd *fds[HEXAGONFS_MAX_FD] = {0};
+	struct hexagonfs_dirent *root;
+	char data[16] = {0};
+	int r, f;
+	assert(argc == 2);
+	root = construct_root_dir(argv[1], "adsp");
+	assert(root);
+	r = hexagonfs_open_root(fds, root);
+	assert(r >= 0);
+	const char *path = "/mnt/vendor/persist/sensors/registry/registry/DIR";
+	f = hexagonfs_openat_flags(fds, r, r, path, O_WRONLY | O_CREAT | O_TRUNC);
+	assert(f >= 0);
+	assert(hexagonfs_write(fds, f, 3, "DIR") == 3);
+	assert(!hexagonfs_close(fds, f));
+	f = hexagonfs_openat_flags(fds, r, r, path, O_WRONLY | O_APPEND);
+	assert(f >= 0);
+	assert(hexagonfs_write(fds, f, 2, "12") == 2);
+	assert(!hexagonfs_close(fds, f));
+	f = hexagonfs_openat(fds, r, r, "/persist/sensors/registry/registry/DIR");
+	assert(f >= 0);
+	assert(hexagonfs_read(fds, f, sizeof(data), data) == 5);
+	assert(!memcmp(data, "DIR12", 5));
+	assert(hexagonfs_write(fds, f, 1, "X") < 0);
+	assert(!hexagonfs_close(fds, f));
+	f = hexagonfs_openat_flags(fds, r, r, path, O_WRONLY | O_TRUNC);
+	assert(f >= 0);
+	assert(!hexagonfs_close(fds, f));
+	f = hexagonfs_openat(fds, r, r, path);
+	assert(f >= 0);
+	assert(hexagonfs_read(fds, f, 1, data) == 0);
+	assert(!hexagonfs_close(fds, f));
+	assert(hexagonfs_openat_flags(fds, r, r, "/vendor/etc/sensors/config/keep", O_WRONLY | O_TRUNC) == -EROFS);
+	assert(hexagonfs_unlinkat(fds, r, r, "/vendor/etc/sensors/config/keep") == -EROFS);
+	assert(hexagonfs_openat_flags(fds, r, r, "/persist/sensors/registry/registry/escape", O_WRONLY | O_TRUNC) == -ELOOP);
+	assert(hexagonfs_openat_flags(fds, r, r, "/persist/sensors/registry/registry/../../other", O_WRONLY | O_CREAT) == -EROFS);
+	assert(hexagonfs_openat_flags(fds, r, r, "/persist/sensors/registry/registry/..", O_WRONLY) == -EISDIR);
+	f = hexagonfs_openat_flags(fds, r, r, "/persist/sensors/registry/fstempfile", O_WRONLY | O_CREAT | O_TRUNC);
+	assert(f >= 0);
+	assert(hexagonfs_write(fds, f, 3, "tmp") == 3);
+	assert(!hexagonfs_close(fds, f));
+	assert(hexagonfs_renameat(fds, r, "/persist/sensors/registry/fstempfile", "/vendor/etc/sensors/config/keep") == -EROFS);
+	assert(!hexagonfs_renameat(fds, r, "/persist/sensors/registry/fstempfile", "/persist/sensors/registry/registry/renamed"));
+	f = hexagonfs_openat(fds, r, r, "/persist/sensors/registry/registry/renamed");
+	assert(f >= 0);
+	assert(hexagonfs_read(fds, f, 3, data) == 3);
+	assert(!memcmp(data, "tmp", 3));
+	assert(!hexagonfs_close(fds, f));
+	assert(hexagonfs_openat(fds, r, r, "/persist/sensors/registry/fstempfile") == -ENOENT);
+	assert(!hexagonfs_unlinkat(fds, r, r, "/persist/sensors/registry/registry/renamed"));
+	assert(!hexagonfs_unlinkat(fds, r, r, path));
+	assert(hexagonfs_openat(fds, r, r, path) == -ENOENT);
+	assert(hexagonfs_write(fds, -1, 3, "DIR") == -EBADF);
+	assert(hexagonfs_write(fds, HEXAGONFS_MAX_FD, 3, "DIR") == -EBADF);
+	/* Aliased handles must not destroy a still-open directory. */
+	int alias = hexagonfs_openat(fds, r, r, "/");
+	assert(alias >= 0);
+	assert(!hexagonfs_close(fds, alias));
+	int parent = hexagonfs_openat(fds, r, r, "/persist/sensors/registry");
+	assert(parent >= 0);
+	int child = hexagonfs_openat(fds, r, parent, "registry");
+	assert(child >= 0);
+	assert(!hexagonfs_close(fds, parent));
+	f = hexagonfs_openat_flags(fds, r, child, "./lifetime", O_WRONLY | O_CREAT | O_TRUNC);
+	assert(f >= 0);
+	assert(hexagonfs_write(fds, f, 1, "x") == 1);
+	assert(!hexagonfs_close(fds, f));
+	assert(!hexagonfs_unlinkat(fds, r, child, "./lifetime"));
+	alias = hexagonfs_openat(fds, r, child, "..");
+	assert(alias >= 0);
+	assert(!hexagonfs_close(fds, child));
+	assert(!hexagonfs_close(fds, alias));
+	assert(!hexagonfs_close(fds, r));
+	puts("PASS: write/read/append/truncate/remove, aliases, read-only denial, symlink/traversal denial, invalid handles");
+}
diff --git a/tests/test_registry.py b/tests/test_registry.py
new file mode 100644
index 0000000..77cc446
--- /dev/null
+++ b/tests/test_registry.py
@@ -0,0 +1,17 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+import pathlib
+import subprocess
+import sys
+import tempfile
+
+# Meson runs tests in the build directory; keep the fixture there.
+with tempfile.TemporaryDirectory(prefix="registry-", dir=".") as tmp:
+    root = pathlib.Path(tmp).resolve()
+    (root / "sensors/state/registry").mkdir(parents=True)
+    (root / "sensors/config").mkdir()
+    keep = root / "sensors/config/keep"
+    keep.write_text("unchanged")
+    (root / "sensors/state/registry/escape").symlink_to(keep)
+    subprocess.run([sys.argv[1], str(root)], check=True)
+    assert keep.read_text() == "unchanged"
