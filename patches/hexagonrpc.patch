+}
+
+static int open_parent(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+		       char *path, char **leaf, bool *opened)
+{
+	int parent = dirfd;
+
+	*opened = false;
+	*leaf = strrchr(path, '/');
+	if (*leaf) {
+		*(*leaf)++ = 0;
+		if (!*path)
+			parent = rootfd;
+		else {
+			parent = hexagonfs_openat(fds, rootfd, dirfd, path);
+			*opened = parent >= 0;
+		}
+	} else {
+		*leaf = path;
+	}
+	return parent;
+}
+
+static int valid_parent(struct hexagonfs_fd **fds, int parent, const char *leaf)
+{
+	if (!*leaf || !strcmp(leaf, ".") || !strcmp(leaf, ".."))
+		return -EINVAL;
+	if (parent < 0)
+		return parent;
+	if (parent >= HEXAGONFS_MAX_FD || !fds[parent])
+		return -EBADF;
+	return 0;
+}
+
+int hexagonfs_unlinkat(struct hexagonfs_fd **fds, int rootfd, int dirfd, const char *name)
+{
+	char *path = strdup(name), *leaf;
+	int parent, ret;
+	bool opened;
+
+	if (!path)
+		return -ENOMEM;
+	parent = open_parent(fds, rootfd, dirfd, path, &leaf, &opened);
+	ret = valid_parent(fds, parent, leaf);
+	if (!ret)
+		ret = fds[parent]->ops->unlink ?
+			fds[parent]->ops->unlink(fds[parent], leaf) : -EROFS;
+	if (opened)
+		hexagonfs_close(fds, parent);
+	free(path);
+	return ret;
+}
+
+int hexagonfs_renameat(struct hexagonfs_fd **fds, int rootfd, const char *name, const char *newname)
+{
+	char *oldpath = strdup(name), *newpath = strdup(newname), *oldleaf, *newleaf;
+	bool oldopened = false, newopened = false;
+	int olddir = -1, newdir = -1, ret = -ENOMEM;
+
+	if (!oldpath || !newpath)
+		goto out;
+	olddir = open_parent(fds, rootfd, rootfd, oldpath, &oldleaf, &oldopened);
+	newdir = open_parent(fds, rootfd, rootfd, newpath, &newleaf, &newopened);
+	ret = valid_parent(fds, olddir, oldleaf);
+	if (!ret)
+		ret = valid_parent(fds, newdir, newleaf);
+	if (!ret)
+		ret = fds[olddir]->ops->rename ?
+			fds[olddir]->ops->rename(fds[olddir], oldleaf, fds[newdir], newleaf) : -EROFS;
+out:
+	if (newopened)
+		hexagonfs_close(fds, newdir);
+	if (oldopened)
+		hexagonfs_close(fds, olddir);
+	free(oldpath);
+	free(newpath);
+	return ret;
+}
+
+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size, const void *ptr)
+{
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD || !fds[fileno])
+		return -EBADF;
+	if (!fds[fileno]->ops->write)
+		return -EROFS;
+	return fds[fileno]->ops->write(fds[fileno], size, ptr);
+}
